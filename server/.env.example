# Server Environment Configuration
PORT=5050
NODE_ENV=production

# MongoDB Connection String (Atlas URI in production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campushome?retryWrites=true&w=majority

# JWT Secret (MUST be at least 32 characters long, cryptographically secure)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters_here
JWT_EXPIRES_IN=7d

# Frontend Client URL (For CORS whitelist and redirection)
CLIENT_URL=https://your-frontend-domain.vercel.app

# Brevo Transactional Email API (For email verification & password reset)
BREVO_API_KEY=your_brevo_api_key_v3
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=CampusHome

# Google OAuth 2.0 Web Client ID (For Google Sign-In verification)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
